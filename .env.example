# Firebase configuration
FIREBASE_API_KEY=<your firebase api key>
FIREBASE_AUTH_DOMAIN=floodsight-flood-monitoring.firebaseapp.com
FIREBASE_PROJECT_ID=floodsight-flood-monitoring
FIREBASE_STORAGE_BUCKET=floodsight-flood-monitoring.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=<your firebase messaging sender id>
FIREBASE_APP_ID=<your firebase app id>

# MongoDB backend configuration
MONGODB_URI=<your mongodb atlas uri>
MONGODB_DB=CCTVs
MONGODB_COLLECTION=cctv data

# Backend base URL override for physical-device testing (optional).
# Leave empty to use the automatic fallback (localhost on web, 10.0.2.2 on the
# Android emulator). For a physical device on the same Wi-Fi/LAN as your dev
# machine, set this to your machine's LAN IP, e.g.:
# BACKEND_URL=http://192.168.1.23:3000
BACKEND_URL=
